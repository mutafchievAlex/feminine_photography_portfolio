# Security Environment Variables

# ⚠️ ВАЖНО: Никога не commit-вайте реални credentials в Git!

# Frontend API Configuration
# Използвайте HTTPS в production
VITE_API_URL=https://your-api-domain.com
VITE_API_BASE_URL=https://your-api-domain.com

# Supabase Configuration
# Получете тези стойности от Supabase dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OIDC Configuration (опционално)
VITE_OIDC_AUTHORITY=https://your-auth-server.com
VITE_OIDC_CLIENT_ID=your-client-id
VITE_OIDC_REDIRECT_URI=https://your-domain.com/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://your-domain.com/

# Default Photographer ID (опционално)
VITE_DEFAULT_PHOTOGRAPHER_ID=11111111-1111-1111-1111-111111111111

# Security Headers (за production server)
# Добавете тези в вашия web server конфигурация (nginx, apache, etc.)

# Content-Security-Policy
# CSP_HEADER="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

# X-Frame-Options
# X_FRAME_OPTIONS=DENY

# X-Content-Type-Options
# X_CONTENT_TYPE_OPTIONS=nosniff

# X-XSS-Protection
# X_XSS_PROTECTION="1; mode=block"

# Referrer-Policy
# REFERRER_POLICY=strict-origin-when-cross-origin

# Permissions-Policy
# PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"

# Strict-Transport-Security (HSTS)
# HSTS_HEADER="max-age=31536000; includeSubDomains"

## Development Mode
# За локална разработка можете да използвате mock mode
# VITE_SUPABASE_URL=https://dummy.supabase.co
# VITE_SUPABASE_ANON_KEY=dummy-key

## Production Checklist
# Преди deployment в production:
# ✅ Всички URLs използват HTTPS
# ✅ API keys са защитени и не са в кода
# ✅ CORS е правилно конфигуриран
# ✅ Rate limiting е активиран на backend
# ✅ Supabase RLS политики са конфигурирани
# ✅ Security headers са добавени
# ✅ SSL сертификат е валиден
# ✅ Backup стратегия е налична
